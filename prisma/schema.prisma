generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USERS ====================

model User {
  id            String    @id @default(cuid())
  // Nullable: an admin created via the allowlist signs in with Google and may
  // never have a phone. OTP signup still always sets it. Postgres allows many
  // NULLs under a UNIQUE index, so uniqueness still holds for real numbers.
  phone         String?   @unique
  // Nullable: OTP users sign up with a phone only and never get an email.
  // Populated for admins who sign in via an external identity provider.
  email         String?   @unique
  role          Role      @default(USER)
  // Section keys a regular ADMIN may access, e.g. ["courses", "coaches"].
  // Meaningless for USER (never consulted) and for SUPER_ADMIN (full access by
  // definition). Read from the DB per request, never from the session token, so
  // revoking a permission takes effect immediately instead of at next login.
  permissions   String[]  @default([])
  name          String?
  avatar        String?
  skillLevel    SkillLevel?
  goal          String?
  birthDate     DateTime?
  gender        String?
  height        Int?
  weight        Int?
  points        Int       @default(0)
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscription  Subscription?
  progress      LessonProgress[]
  favorites     Favorite[]
  tickets       Ticket[]
  payments      Payment[]
  orders        Order[]
  notifications Notification[]
  addresses     Address[]
  badges        UserBadge[]
  lessonBookmarks LessonBookmark[]
  courseAccess   CourseAccess[]
  moodLogs      MoodLog[]
  walletTx      WalletTransaction[]
  walletBalance Int       @default(0)
  lastLoginAt   DateTime?
  lastLoginIp   String?
  // Last authenticated REQUEST, not last login — written by touchLastSeen in
  // lib/presence at most once per throttle window per user. Deliberately a
  // separate column from lastLoginAt: one answers "when did they sign in", this
  // one answers "are they here right now", and the admin list needs both.
  lastSeenAt    DateTime?
  cart          Json?
  referralCode  String    @unique @default(cuid())
  referredBy    String?

  // The admin user list sorts and filters on presence; without this the online
  // filter is a sequential scan of every user row.
  @@index([lastSeenAt])
  @@map("users")
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// SUPER_ADMIN is strictly above ADMIN: it ignores `permissions` and may manage
// the admin list. Membership is additionally guaranteed by the SUPER_ADMIN_EMAILS
// env floor (see lib/access), so this column can never lock the owners out.
enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

// ==================== COURSES ====================

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  thumbnail   String?
  category    CourseCategory
  level       SkillLevel
  coachId     String
  coach       Coach    @relation(fields: [coachId], references: [id])
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  price       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters    Chapter[]
  favorites   Favorite[]
  courseAccess CourseAccess[]

  @@map("courses")
}

enum CourseCategory {
  GENERAL
  SPEED
  FREESTYLE
  SLALOM
  HOCKEY
}

model Chapter {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  courseId   String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons   Lesson[]

  @@map("chapters")
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  duration    Int      @default(0) // seconds
  thumbnail   String?
  order       Int      @default(0)
  isFree      Boolean  @default(false)
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  progress    LessonProgress[]
  bookmarks   LessonBookmark[]
  tickets     Ticket[]

  @@map("lessons")
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean  @default(false)
  watchedSec  Int      @default(0)
  lastWatched DateTime @default(now())

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ==================== COACHES ====================

model Coach {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  avatar    String?
  specialty String?
  courses   Course[]

  @@map("coaches")
}

// ==================== SUBSCRIPTIONS ====================

model SubscriptionPlan {
  id            String   @id @default(cuid())
  title         String
  durationDays  Int
  price         Int      // toman
  originalPrice Int?     // for showing discount
  isActive      Boolean  @default(true)
  order         Int      @default(0)

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  startDate DateTime @default(now())
  endDate   DateTime
  isActive  Boolean  @default(true)

  @@map("subscriptions")
}

// ==================== PAYMENTS ====================

model Payment {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  status      PaymentStatus @default(PENDING)
  authority   String?       // zarinpal authority
  refId       String?       // zarinpal ref id
  description String?
  createdAt   DateTime      @default(now())

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// ==================== FAVORITES ====================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@map("favorites")
}

// ==================== TICKETS ====================

model Ticket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id])
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  messages  TicketMessage[]

  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  content   String
  isAdmin   Boolean  @default(false)
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@map("ticket_messages")
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

// ==================== SHOP ====================

model Product {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Int
  originalPrice Int?
  thumbnail   String?
  images      String[] @default([])
  category    ProductCategory
  brand       String?
  inStock     Boolean  @default(true)
  isPublished Boolean  @default(true)
  customizable Boolean  @default(false)
  options      Json?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]

  @@map("products")
}

enum ProductCategory {
  INLINE_SKATE
  SPEED_SKATE
  PROTECTIVE_GEAR
  WHEELS
  BEARINGS
  ACCESSORIES
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount Int
  status      OrderStatus @default(PENDING)
  trackingCode String?
  address     String?
  phone       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  price     Int
  selectedOptions Json?

  @@map("order_items")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// ==================== NOTIFICATIONS ====================
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(GENERAL)
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

enum NotificationType {
  GENERAL
  TICKET_REPLY
  ORDER_UPDATE
  SUBSCRIPTION
  SYSTEM
}

// ==================== ADDRESSES ====================
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  province  String
  city      String
  address   String
  postalCode String?
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("addresses")
}

// ==================== GAMIFICATION ====================
model Badge {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String
  icon        String
  color       String   @default("#F5B800")
  condition   String
  points      Int      @default(0)
  userBadges  UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ==================== COUPONS ====================
model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  type          CouponType
  value         Int
  minAmount     Int?
  maxDiscount   Int?
  usageLimit    Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  description   String?
  scope         CouponScope  @default(ALL)
  createdAt     DateTime  @default(now())
  usages        CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  amount    Int
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
  @@map("coupon_usages")
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponScope {
  ALL
  SUBSCRIPTION
  SHOP
}

// ==================== BANNERS ====================

model Banner {
  id        String   @id @default(cuid())
  title     String?
  link      String?
  imageKey  String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

// ==================== GIFT CARDS ====================
model GiftCard {
  id        String    @id @default(cuid())
  code      String    @unique
  amount    Int
  scope     CouponScope @default(ALL)
  isUsed    Boolean   @default(false)
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@map("gift_cards")
}

// ==================== BOOKMARKS & NOTES ====================
model LessonBookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@map("lesson_bookmarks")
}

// ==================== COURSE ACCESS (individual purchase) ====================
model CourseAccess {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  amount      Int
  purchasedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@map("course_access")
}

// ==================== MOOD LOG ====================
model MoodLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      String
  createdAt DateTime @default(now())

  @@map("mood_logs")
}

// ==================== FAQ ====================
model FaqCategory {
  id        String    @id @default(cuid())
  title     String
  order     Int       @default(0)
  items     FaqItem[]
  createdAt DateTime  @default(now())

  @@map("faq_categories")
}

model FaqItem {
  id         String      @id @default(cuid())
  categoryId String
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  question   String
  answer     String
  order      Int         @default(0)
  createdAt  DateTime    @default(now())

  @@map("faq_items")
}

// ==================== WALLET TRANSACTIONS ====================
model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  type        String   // GIFT_CARD, COURSE_PURCHASE, REFUND, TOP_UP
  description String
  createdAt   DateTime @default(now())

  @@map("wallet_transactions")
}

// ==================== SHIPPING METHODS ====================
model ShippingMethod {
  id             String   @id @default(cuid())
  title          String
  price          Int
  description    String?
  minFreeAmount  Int?     // free shipping above this amount
  paymentType    String   @default("PREPAID") // PREPAID or COD
  isActive       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  @@map("shipping_methods")
}

// ==================== SOCIAL LINKS ====================
model SocialLink {
  id       String  @id @default(cuid())
  platform String  // instagram, telegram, linkedin, x, youtube, aparat
  url      String
  order    Int     @default(0)
  isActive Boolean @default(true)

  @@map("social_links")
}
