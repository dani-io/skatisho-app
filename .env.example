# =============================================================================
# Skatisho — environment template. Copy to .env and fill in.
#   cp .env.example .env
#
# NEVER put real secrets in this file — .env.example is committed to git.
# .env is excluded by both .gitignore and .dockerignore, so it never enters the
# image; docker-compose.yml injects it at RUNTIME via env_file.
#
# -----------------------------------------------------------------------------
# BUILD-TIME vs RUNTIME — read this before changing a domain.
#
# Exactly ONE variable here is baked into the image: NEXT_PUBLIC_CDN_URL. It is
# relative ("/media"), so it is domain-independent and never needs to change.
#
# Everything else — including NEXT_PUBLIC_SITE_URL, despite the NEXT_PUBLIC_
# prefix — is read at runtime. lib/env.ts reads it through a dynamic
# process.env[name] lookup that Next cannot inline, so the SAME image serves
# new.skatisho.com on DigitalOcean and skatisho.com on the Iran VPS. Moving
# domains is an .env edit + an nginx server_name + a reissued certificate.
# NO REBUILD. Verified: a build with a sentinel NEXT_PUBLIC_SITE_URL produces
# zero occurrences of it anywhere in .next.
# =============================================================================


# --- CORE --------------------------------------------------------------------

# Postgres. The compose stack runs its own; the host is the service name, and
# it is unreachable from outside the internal Docker network.
POSTGRES_USER=skatisho
POSTGRES_DB=skatisho
POSTGRES_PASSWORD=                 # MUST SET — openssl rand -base64 24

# Must match the three values above. Prisma 6.19.3 (pinned; never v7).
DATABASE_URL=postgresql://skatisho:CHANGE_ME@postgres:5432/skatisho?schema=public

# Session signing key for the jose JWT (HS256, 30-day cookie). Used by both
# lib/auth and the proxy gate — the app throws on first use if it is missing.
# Changing it invalidates every existing session.
JWT_SECRET=                        # MUST SET — openssl rand -base64 32

# Public origin, no trailing slash. RUNTIME, not build-time (see header).
# Used for the Google OAuth redirect_uri, which must match the value registered
# in Google Console byte for byte.
#   DigitalOcean: https://new.skatisho.com
#   Iran/Arvan:   https://skatisho.com
NEXT_PUBLIC_SITE_URL=https://new.skatisho.com

# Origin used to build the Zarinpal payment callback URL.
# Set it explicitly: when unset the payment routes fall back to the request
# origin, which behind nginx is derived from the Host header and can come out
# as http:// — Zarinpal would then call back on the wrong scheme.
# Normally identical to NEXT_PUBLIC_SITE_URL.
APP_URL=https://new.skatisho.com


# --- STORAGE (MinIO, internal network only) ----------------------------------

# S3_ENDPOINT is forced to http://minio:9000 by docker-compose.yml and must not
# be set here. Set it only for local dev against a standalone MinIO.
#S3_ENDPOINT=http://localhost:9000

S3_REGION=us-east-1                # MinIO ignores this; the SDK requires it

# Also become the MinIO root credentials (compose wires them to
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD). Secret must be at least 8 characters.
S3_ACCESS_KEY=                     # MUST SET
S3_SECRET_KEY=                     # MUST SET

S3_BUCKET_PRIVATE=sktsho-private   # course video, user avatars — never public
S3_BUCKET_PUBLIC=sktsho-public     # covers, product shots, banners, coach photos

# BUILD ARG — the only value baked into the image. Base for public media URLs,
# pointing at the app's own /media route, which streams objects out of the
# public bucket. Keep it RELATIVE: an absolute value bakes one hostname into the
# bundle and would need a rebuild to change. Only set this to something else if
# a real CDN is ever placed in front of /media (which would also require giving
# the public bucket an anonymous download policy — see docker-compose.yml).
NEXT_PUBLIC_CDN_URL=/media


# --- ADMIN FLOOR (anti-lockout) ----------------------------------------------
# Identities that hold SUPER_ADMIN regardless of what the database says. This is
# what gets the owners back in when a role column is wrong, a row was deleted,
# or a migration has not run yet.
#
# ON A FRESH DEPLOYMENT WITH AN EMPTY DATABASE THERE IS NO ADMIN AND NO WAY IN
# UNTIL AT LEAST ONE OF THESE IS SET. Comma-separated; blanks ignored.
# Emails are lower-cased before comparison and matched against the address
# Google reports as verified.
SUPER_ADMIN_EMAILS=                # e.g. owner@example.com,second@example.com
SUPER_ADMIN_PHONES=                # e.g. 09123456789   (OTP sign-in instead)


# --- GOOGLE OAUTH (admin sign-in) --------------------------------------------
# Admin panel only; regular users keep using SMS OTP. If both are unset the app
# still builds and runs — only the two /api/auth/google* routes fail, and the
# OTP path is unaffected.
#
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Authorized redirect URI must be EXACTLY:
#     ${NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
# i.e. https://new.skatisho.com/api/auth/google/callback on DigitalOcean.
# Add the Iran URI to the same client before switching domains.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- SMS / OTP ---------------------------------------------------------------
# test | selfhosted | kavenegar. An unset or misspelled value falls back to
# `selfhosted`, never to `test` — `test` accepts a fixed code and must never be
# reachable by accident in production.
SMS_PROVIDER=selfhosted

# selfhosted: a gateway exposing /otp/send and /otp/verify. It holds OTP state
# itself. NOTE: a LAN address here is unreachable from a DigitalOcean droplet —
# use a publicly routable URL, or SMS_PROVIDER=test for DO smoke testing.
SMS_SELFHOSTED_URL=
SMS_SELFHOSTED_KEY=

# kavenegar: the app owns the code and keeps it in a per-process in-memory map,
# which is why the app must stay at one replica (see docker-compose.yml).
SMS_KAVENEGAR_KEY=


# --- PAYMENT (Zarinpal) ------------------------------------------------------
ZARINPAL_MERCHANT=                 # falls back to an all-zero UUID if unset
# Read as: sandbox UNLESS the value is exactly the string "false".
# Evaluated at module load, so a change needs a container restart.
ZARINPAL_SANDBOX=true              # "false" for real payments


# --- OPS ---------------------------------------------------------------------
# Tags the built image (skatisho-app:${APP_VERSION}), so `docker save` has a
# stable name to export for the Iran transfer. Bump per release.
APP_VERSION=local


# =============================================================================
# NOT USED — do not reintroduce.
#
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_EMAIL: web push is not
#   implemented. There is no web-push dependency and public/sw.js has no push
#   handler. These were carried by the old config and read by nothing.
# NEXTAUTH_URL: next-auth is not imported anywhere in src/.
# SMS_API_KEY / SMS_SENDER: superseded by the SMS_* provider layer above.
# MEDIA_PATH: superseded by object storage.
# =============================================================================
